# Data nyata hasil unduhan TIDAK di-commit: ukurannya besar dan kita ingin
# peserta mengalami sendiri proses pengambilan data.
data/real/
*.dat
*.hea
*.atr
*.qrs

# Pengecualian: data demo panggung SENGAJA di-commit supaya live demo pada
# hari-H tidak bergantung pada jaringan Teater B. MIT-BIH berlisensi ODC-BY 1.0
# sehingga redistribusi turunan diizinkan dengan atribusi (lihat ATTRIBUTION.md).
!data/demo/
!data/demo/*.csv
!data/demo/*.md
data/demo/demo_preview.png

